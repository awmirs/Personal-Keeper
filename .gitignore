# --- Rust ---
/target/
**/*.rs.bk
*.pdb

# Cargo lock for end applications
# Cargo.lock

# --- IDE / Editors ---
.vscode/
.idea/
*.iml
*.swp
*.swo
*~
.project
.classpath
.settings/
.DS_Store
Thumbs.db

# --- Environment / Secrets ---
.env
.env.local
.env.*.local
*.pem
*.key
*.crt
*.p12
*.pfx
config/default.local.toml

# --- Database & Data ---
*.db
*.sqlite
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
data/
# but keep the directory structure if needed
!data/.gitkeep

# --- Backup files ---
*.backup
*.bak

# --- Docker ---
docker-compose.override.yml
*.tar

# --- Project specific ---
secrets/
backups/
.gitingestignore
digest.txt

# --- Vendor (if using `cargo vendor`) ---
vendor/

# --- Generated files ---
api/static/            # frontend build output (generated by CI)
/resources/ (if any)   # may hold embedded assets, but usually build output

# --- Logs ---
*.log
logs/

# --- Node / Frontend
frontend/node_modules/
frontend/dist/
frontend/.output/

# --- Testing / Coverage ---
coverage/
*.profraw
*.profdata

# --- OS junk ---
__pycache__/
*.pyc